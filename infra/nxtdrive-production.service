# systemd unit for the PRODUCTION Next.js app.
# Managed by infra/bootstrap.sh — installed to
#   /etc/systemd/system/nxtdrive-production.service
# then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable nxtdrive-production
# (first deploy starts it once current/ exists)
[Unit]
Description=NXTDRIVE Next.js (production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deployer
Group=nxtdrive
WorkingDirectory=/var/www/nxtdrive/production/current
EnvironmentFile=/var/www/nxtdrive/production/shared/.env
Environment=NODE_ENV=production
Environment=PORT=5001
# Writable HOME outside /home so pnpm/Next caches work under ProtectHome.
StateDirectory=nxtdrive-production
Environment=HOME=/var/lib/nxtdrive-production
ExecStart=/usr/bin/pnpm --filter @workspace/nxtdrive run start

# Graceful stop: Next handles SIGTERM; give in-flight requests time to drain.
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

# --- Hardening ---
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nxtdrive-production

[Install]
WantedBy=multi-user.target
