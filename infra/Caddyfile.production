# Caddy reverse proxy for PRODUCTION — app.nxtdrive.io
# Deploy path: /var/www/nxtdrive/production
# The Next.js app runs on 127.0.0.1:5001 (systemd unit nxtdrive-production).
# Global options (email for Let's Encrypt) live in /etc/caddy/Caddyfile.
# Reloaded by the GitHub self-hosted runner via: sudo systemctl reload caddy

app.nxtdrive.io {
        encode gzip zstd

        header {
                # HSTS — force HTTPS for a year, including subdomains.
                Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                X-Frame-Options "SAMEORIGIN"
                # Hide upstream server identity.
                -Server
        }

        reverse_proxy 127.0.0.1:5001 {
                header_up X-Forwarded-Proto {scheme}
                header_up X-Forwarded-Host {host}
                header_up X-Real-IP {remote_host}
                flush_interval -1
        }

        # Rate limiting: the default Caddy binary has no rate_limit directive.
        # To enable, build Caddy with the caddy-ratelimit plugin (xcaddy) and
        # add a `rate_limit` block here. See docs/INFRA_DEPLOYMENT.md.

        log {
                output file /var/log/caddy/app.nxtdrive.io.log {
                        roll_size 50mb
                        roll_keep 5
                }
                format json
        }
}

# www → apex redirect (canonical domain is nxtdrive.io without www)
www.nxtdrive.io {
        redir https://nxtdrive.io{uri} permanent
}

# Root domain — platform marketing/landing page.
nxtdrive.io {
        encode gzip zstd

        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                X-Frame-Options "SAMEORIGIN"
                -Server
        }

        reverse_proxy 127.0.0.1:5001 {
                header_up X-Forwarded-Proto {scheme}
                header_up X-Forwarded-Host {host}
                header_up X-Real-IP {remote_host}
                flush_interval -1
        }

        log {
                output file /var/log/caddy/nxtdrive.io.log {
                        roll_size 50mb
                        roll_keep 5
                }
                format json
        }
}

# ----------------------------------------------------------------------------
# Wildcard tenant subdomains — <school>.nxtdrive.io
#
# Every driving school is reachable at its own subdomain WITHOUT a per-school
# Caddy/DNS change. The app resolves the tenant from the host header
# (lib/tenant/resolve-host.ts). TLS uses a single wildcard certificate obtained
# via the Cloudflare DNS-01 challenge, which REQUIRES a Caddy build that includes
# the cloudflare DNS plugin plus CLOUDFLARE_API_TOKEN in the service environment.
#
# Because that plugin is NOT present on a default Caddy install, the wildcard
# site block lives in a SEPARATE opt-in file: `infra/Caddyfile.wildcard`. It is
# intentionally not enabled by bootstrap.sh so `caddy validate` succeeds on a
# fresh box. Enable it as a one-time post-step (see docs/INFRA_ROADMAP.md):
#   sudo caddy add-package github.com/caddy-dns/cloudflare
#   # set CLOUDFLARE_API_TOKEN in /etc/caddy/caddy.env
#   sudo cp infra/Caddyfile.wildcard /etc/caddy/sites-enabled/wildcard
#   sudo systemctl restart caddy
#
# Until enabled, tenant subdomains fall through to the custom-domain on-demand
# catch-all below (whose ask endpoint returns 403 for *.nxtdrive.io, so no cert
# is issued — provisioning never breaks).
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Custom tenant domains (white-label) — e.g. rijschoolxyz.nl
#
# Caddy serves ANY other HTTPS host here using on-demand TLS: before issuing a
# certificate it asks the app (on_demand_tls { ask ... } in /etc/caddy/Caddyfile)
# whether the host is a verified custom domain (tenant_domains.status='active').
# This catch-all is the least specific block, so it only handles hosts not
# matched above. Unverified/unknown hosts are rejected by the ask endpoint and
# never get a cert.
# ----------------------------------------------------------------------------
https:// {
        encode gzip zstd

        tls {
                on_demand
        }

        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                X-Frame-Options "SAMEORIGIN"
                -Server
        }

        reverse_proxy 127.0.0.1:5001 {
                header_up X-Forwarded-Proto {scheme}
                header_up X-Forwarded-Host {host}
                header_up X-Real-IP {remote_host}
                flush_interval -1
        }

        log {
                output file /var/log/caddy/custom-domains.log {
                        roll_size 50mb
                        roll_keep 5
                }
                format json
        }
}
